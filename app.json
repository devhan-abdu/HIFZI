{
  "expo": {
    "name": "Hifzi",
    "slug": "hifzi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/hifzilogo.png",
    "scheme": "hifzi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "enforceContrast": false
    },
    "splash": {
      "image": "./assets/images/hifzilogowhite.png",
      "resizeMode": "contain",
      "backgroundColor": "#276359"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devhananabdu.hifzi.dev",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.devhananabdu.hifzi",
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "assetBundlePatterns": [
      "assets/fonts/*",
      "assets/images/*",
      "assets/db/*"
    ],
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/rosemary.ttf",
            "./assets/fonts/uthman.ttf"
          ]
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d00968f2-eb77-46b1-802b-8ef6df222d47"
      }
    },
    "owner": "devhan-abdu",
    "updates": {},
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
